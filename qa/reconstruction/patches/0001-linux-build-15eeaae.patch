index 0000000000000000000000000000000000000000..27766b09d8f90d29cd16dec51fe4ba73ef7d0a08
--- /dev/null
+++ b/android/toolchain/host_env.sh
@@ -0,0 +1,30 @@
+#!/bin/bash
+# Shared host paths for the Android build and device-test scripts. Source this file.
+# Keep the donor's NDK version and target ABI; only select the host tool binaries.
+
+case "$(uname -s):$(uname -m)" in
+  Linux:x86_64|Linux:amd64)
+    KAM_NDK_HOST_TAG=linux-x86_64
+    KAM_DEFAULT_SDK="$HOME/Android/Sdk"
+    ;;
+  Darwin:x86_64|Darwin:arm64)
+    # The NDK macOS tools use this directory name on both supported host CPUs.
+    KAM_NDK_HOST_TAG=darwin-x86_64
+    KAM_DEFAULT_SDK="$HOME/Library/Android/sdk"
+    ;;
+  *)
+    echo "Unsupported Android build host: $(uname -s) $(uname -m)" >&2
+    return 1
+    ;;
+esac
+
+KAM_SDK="${ANDROID_HOME:-${ANDROID_SDK_ROOT:-$KAM_DEFAULT_SDK}}"
+KAM_NDK="${ANDROID_NDK_HOME:-$KAM_SDK/ndk/29.0.13599879}"
+KAM_NDK_BIN="$KAM_NDK/toolchains/llvm/prebuilt/$KAM_NDK_HOST_TAG/bin"
+if [ ! -d "$KAM_NDK_BIN" ]; then
+  echo "Android NDK host tools not found at $KAM_NDK_BIN" >&2
+  return 1
+fi
+
+# The generated FPC assembler wrapper uses these paths in child processes.
+export KAM_NDK KAM_NDK_BIN
